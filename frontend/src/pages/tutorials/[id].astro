---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { getAllTutorials, type TutorialItem } from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown';

export function getStaticPaths() {
  const tutorials = getAllTutorials();
  return tutorials.map((t, idx) => {
    const prev = idx > 0 ? tutorials[idx - 1] : null;
    const next = idx < tutorials.length - 1 ? tutorials[idx + 1] : null;
    return {
      params: { id: t.id },
      props: { tutorial: t, prev, next },
    };
  });
}

interface Props {
  tutorial: TutorialItem;
  prev: TutorialItem | null;
  next: TutorialItem | null;
}

const { tutorial, prev, next } = Astro.props;

// Render mathematics or formulas with KaTeX
const mathHtml = renderMarkdown(tutorial.mathematics);
---

<BaseLayout title={`Tutorial ${tutorial.id}: ${tutorial.title}`} currentPath="/tutorials">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <!-- Breadcrumb & Progress bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-neutral-500 border-b border-black/[0.06] dark:border-white/[0.08] pb-4">
      <div class="flex items-center gap-2">
        <a href="/tutorials" class="hover:text-blue-600 transition-colors">Tutorials</a>
        <span>/</span>
        <span class="font-mono text-neutral-900 dark:text-neutral-100 font-semibold">Lesson {tutorial.id}</span>
      </div>

      <ReadingProgress unitId={`tutorial-${tutorial.id}`} unitTitle={tutorial.title} />
    </div>

    <!-- Title & Distinction Header -->
    <header class="space-y-3">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300">
          Tutorial {tutorial.id} of 14
        </span>
        <span class="text-xs font-mono text-neutral-400">
          {tutorial.sourceFile}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100">
        {tutorial.title}
      </h1>

      <!-- Central distinction badge -->
      <div class="p-3.5 rounded-xl bg-neutral-100 dark:bg-neutral-800/80 border border-black/[0.04] dark:border-white/[0.04] text-xs flex items-center gap-2">
        <span class="font-semibold text-neutral-700 dark:text-neutral-300">Central Distinction:</span>
        <span class="font-medium text-blue-600 dark:text-blue-400">{tutorial.centralDistinction}</span>
      </div>
    </header>

    <!-- Four Structured Sections -->
    <div class="space-y-6">
      <!-- 1. Intuition -->
      <section class="apple-card p-6 md:p-7 space-y-2">
        <div class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider">
          1. Intuitive Framing
        </div>
        <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
          {tutorial.intuition}
        </p>
      </section>

      <!-- 2. Mathematics -->
      <section class="apple-card p-6 md:p-7 space-y-2">
        <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">
          2. Mathematical Formalism
        </div>
        <div class="prose-content text-sm sm:text-base text-neutral-700 dark:text-neutral-300" set:html={mathHtml} />
      </section>

      <!-- 3. Experiment Implementation -->
      <section class="apple-card p-6 md:p-7 space-y-4">
        <div class="text-xs font-semibold text-purple-600 dark:text-purple-400 uppercase tracking-wider">
          3. Executable Experiment
        </div>
        <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
          {tutorial.experiment}
        </p>

        <!-- Command bar -->
        <div class="space-y-1.5">
          <div class="text-xs text-neutral-400 font-medium">Run from repository root:</div>
          <div class="flex items-center justify-between p-3 rounded-xl bg-neutral-900 text-neutral-100 font-mono text-xs overflow-x-auto">
            <code>{tutorial.cliCommand}</code>
          </div>
        </div>

        <!-- Python Source Code -->
        <div class="space-y-2 pt-2">
          <div class="text-xs font-semibold text-neutral-700 dark:text-neutral-300 flex items-center justify-between">
            <span>Implementation Logic (<code class="font-mono text-[11px]">tutorials/_shared.py</code>)</span>
            <span class="text-[10px] text-neutral-400 font-mono">Python 3.12</span>
          </div>
          <pre class="p-4 rounded-xl bg-neutral-900 text-neutral-100 font-mono text-xs overflow-x-auto leading-relaxed border border-white/10"><code>{tutorial.lessonCode || tutorial.runnerCode}</code></pre>
        </div>
      </section>

      <!-- 4. Interpretation & Limitations -->
      <section class="apple-card p-6 md:p-7 space-y-2 border-l-4 border-l-amber-500">
        <div class="text-xs font-semibold text-amber-700 dark:text-amber-400 uppercase tracking-wider">
          4. Interpretation & Scientific Limitations
        </div>
        <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
          {tutorial.interpretation}
        </p>
      </section>
    </div>

    <!-- Companion Note Card (if mapped) -->
    {tutorial.companionNoteSlug && (
      <div class="p-5 rounded-2xl bg-neutral-50 dark:bg-[#161618] border border-black/[0.04] dark:border-white/[0.04] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <div>
          <span class="text-neutral-400">Companion Conceptual Note:</span>
          <div class="font-semibold text-neutral-900 dark:text-neutral-100 text-sm mt-0.5">
            notes/{tutorial.companionNoteSlug}.md
          </div>
        </div>
        <a
          href={`/notes/${tutorial.companionNoteSlug}`}
          class="px-4 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 font-medium hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition-colors w-fit"
        >
          Read Conceptual Note &rarr;
        </a>
      </div>
    )}

    <!-- Prev / Next Navigation -->
    <nav class="pt-6 border-t border-black/[0.06] dark:border-white/[0.08] grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prev ? (
        <a
          href={`/tutorials/${prev.id}`}
          class="p-4 rounded-xl border border-black/[0.06] dark:border-white/[0.08] hover:border-black/20 dark:hover:border-white/20 transition-all text-left space-y-1 group"
        >
          <div class="text-[11px] text-neutral-400">&larr; Previous Lesson</div>
          <div class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400">
            {prev.id}: {prev.title}
          </div>
        </a>
      ) : (
        <div></div>
      )}

      {next ? (
        <a
          href={`/tutorials/${next.id}`}
          class="p-4 rounded-xl border border-black/[0.06] dark:border-white/[0.08] hover:border-black/20 dark:hover:border-white/20 transition-all text-right space-y-1 group sm:col-start-2"
        >
          <div class="text-[11px] text-neutral-400">Next Lesson &rarr;</div>
          <div class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400">
            {next.id}: {next.title}
          </div>
        </a>
      ) : (
        <div></div>
      )}
    </nav>
  </div>
</BaseLayout>
