---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalVsGlobalExplainer from '../../components/Explainers/LocalVsGlobalExplainer.astro';
import ProbeVsCausalExplainer from '../../components/Explainers/ProbeVsCausalExplainer.astro';
---

<BaseLayout title="Client-Side Interactive Explainers" currentPath="/explainers">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-black/[0.06] dark:border-white/[0.08] pb-6">
      <div>
        <div class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-1">
          Deterministic Mathematical Demonstrations
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100">
          Interactive Explainers
        </h1>
        <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mt-1 max-w-2xl">
          Zero-backend, 100% deterministic browser-local mathematical tools designed to build intuition for the lab’s core scientific distinctions.
        </p>
      </div>

      <div class="px-3 py-1.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-[11px] text-neutral-500 dark:text-neutral-400 border border-black/[0.04] dark:border-white/[0.06] w-fit">
        Runs purely in client-side TypeScript • No model downloads
      </div>
    </div>

    <!-- Explainer 1 -->
    <section id="local-global" class="scroll-mt-24 space-y-3">
      <LocalVsGlobalExplainer />
    </section>

    <!-- Explainer 2 -->
    <section id="probe-causal" class="scroll-mt-24 space-y-3">
      <ProbeVsCausalExplainer />
    </section>

    <!-- Epistemic Grounding Note -->
    <div class="p-6 rounded-2xl bg-neutral-100/70 dark:bg-[#161618]/70 border border-black/[0.06] dark:border-white/[0.08] text-xs text-neutral-600 dark:text-neutral-400 space-y-2">
      <div class="font-semibold text-neutral-800 dark:text-neutral-200">
        Scientific Scope of These Demonstrations
      </div>
      <p class="leading-relaxed">
        These interactive widgets are deterministic mathematical illustrations of the concepts taught in <strong>Tutorial 01</strong>, <strong>Tutorial 03</strong>, and <strong>Tutorial 08</strong>. They illustrate algebraic properties of Taylor approximations and linear readout probes. They are <strong>not</strong> empirical experiments run on transformer weights. For actual empirical results on pretrained models and synthetic dynamics, see the <a href="/results" class="text-blue-600 dark:text-blue-400 font-medium hover:underline">Results Explorer</a>.
      </p>
    </div>
  </div>
</BaseLayout>
