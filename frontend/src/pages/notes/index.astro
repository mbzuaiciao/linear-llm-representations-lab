---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllNotes } from '../../lib/content';

const notes = getAllNotes();
---

<BaseLayout title="All 13 Conceptual Notes" currentPath="/notes">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-black/[0.06] dark:border-white/[0.08] pb-6">
      <div>
        <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider mb-1">
          Conceptual Spine
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100">
          13 Research Notes
        </h1>
        <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mt-1 max-w-2xl">
          Theoretical taxonomy, mathematical foundations, failure modes, literature mapping, and glossary.
        </p>
      </div>

      <button
        type="button"
        data-open-search
        class="px-3.5 py-1.5 text-xs rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors inline-flex items-center gap-1.5 w-fit"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Search Notes
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {notes.map((n) => (
        <article class="apple-card p-6 apple-card-hover flex flex-col justify-between space-y-4">
          <div class="space-y-2.5">
            <div class="flex items-center justify-between text-xs">
              <span class="font-mono text-emerald-600 dark:text-emerald-400 font-medium">
                notes/{n.slug}.md
              </span>
              <span class="text-neutral-400 text-[11px]">
                {n.readingTimeMinutes} min read
              </span>
            </div>

            <h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
              <a href={`/notes/${n.slug}`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                {n.title}
              </a>
            </h2>

            <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-3 leading-relaxed">
              {n.rawContent.slice(0, 160).replace(/#+\s+/g, '').replace(/\n+/g, ' ')}...
            </p>
          </div>

          <div class="pt-4 border-t border-black/[0.04] dark:border-white/[0.04] flex items-center justify-between text-xs">
            {n.relatedTutorialIds.length > 0 ? (
              <span class="text-[11px] text-neutral-400">
                Tutorials: {n.relatedTutorialIds.join(', ')}
              </span>
            ) : (
              <span class="text-[11px] text-neutral-400">Reference Note</span>
            )}

            <a
              href={`/notes/${n.slug}`}
              class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1"
            >
              Read Note &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
