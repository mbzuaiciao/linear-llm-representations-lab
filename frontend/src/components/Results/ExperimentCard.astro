---
import type { ExperimentSummary } from '../../lib/results';

interface Props {
  experiment: ExperimentSummary;
  figureUrl?: string;
  metricsSummary?: Record<string, string | number>;
}

const { experiment, figureUrl, metricsSummary } = Astro.props;
---

<div id={experiment.id} class="apple-card p-6 md:p-8 space-y-5 scroll-mt-24">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-black/[0.06] dark:border-white/[0.08] pb-4">
    <div>
      <div class="flex flex-wrap items-center gap-2 mb-1.5">
        <span class={`px-2.5 py-0.5 text-[11px] font-medium rounded-full ${
          experiment.modelType === 'pretrained'
            ? 'bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300'
            : 'bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400'
        }`}>
          {experiment.modelType === 'pretrained' ? 'Pretrained Transformer' : 'Synthetic Data'}
        </span>
        <span class="px-2.5 py-0.5 text-[11px] font-medium rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 capitalize">
          {experiment.evaluationType}
        </span>
        <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300">
          Committed Artifact
        </span>
      </div>
      <h3 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
        {experiment.title}
      </h3>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
        {experiment.subtitle}
      </p>
    </div>

    <code class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2.5 py-1 rounded-lg w-fit">
      {experiment.script}
    </code>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center">
    <!-- Visual Artifact / Figure or Fallback -->
    <div class="apple-card p-3 bg-neutral-50 dark:bg-[#141416] flex flex-col justify-center min-h-[220px]">
      {
        experiment.hasFigure ? (
          <img
            src={figureUrl || experiment.figureUrl}
            alt={experiment.title}
            class="w-full rounded-lg border border-black/[0.04] dark:border-white/[0.06] shadow-sm max-h-[280px] object-contain mx-auto"
            loading="lazy"
          />
        ) : (
          <div class="p-6 text-center space-y-2">
            <div class="w-10 h-10 rounded-full bg-neutral-200 dark:bg-neutral-800 text-neutral-500 mx-auto flex items-center justify-center text-sm font-semibold">
              FIG
            </div>
            <div class="text-xs font-semibold text-neutral-700 dark:text-neutral-300">
              No Visual Plot Committed
            </div>
            <p class="text-[11px] text-neutral-400 max-w-xs mx-auto">
              This experiment outputs numeric JSON metrics only. A graphical plot is not generated by default.
            </p>
          </div>
        )
      }
    </div>

    <!-- Content & Caveats -->
    <div class="space-y-4">
      {metricsSummary && Object.keys(metricsSummary).length > 0 && (
        <div class="p-4 rounded-xl bg-neutral-50 dark:bg-[#161618] border border-black/[0.04] dark:border-white/[0.04]">
          <div class="text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-2">
            Committed Metrics Summary
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
            {Object.entries(metricsSummary).map(([key, value]) => (
              <div class="p-2 rounded-lg bg-white dark:bg-neutral-900 border border-black/[0.03] dark:border-white/[0.03]">
                <div class="text-[10px] text-neutral-400 capitalize">{key.replace(/_/g, ' ')}</div>
                <div class="font-mono font-semibold text-neutral-900 dark:text-neutral-100 tabular-nums">
                  {typeof value === 'number' ? (Number.isInteger(value) ? value : value.toFixed(4)) : value}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Primary Caveat -->
      <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-900 dark:text-amber-300">
        <span class="font-semibold text-amber-800 dark:text-amber-300">Methodological Caution:</span>
        <span class="ml-1 text-[11px] text-amber-700 dark:text-amber-400">{experiment.primaryCaveat}</span>
      </div>

      <!-- Execution Command -->
      <div class="text-xs">
        <span class="text-neutral-400 text-[11px]">Command to execute:</span>
        <div class="mt-1 flex items-center justify-between gap-2 p-2 rounded-lg bg-neutral-100 dark:bg-neutral-800/80 font-mono text-[11px] text-neutral-800 dark:text-neutral-200">
          <code class="truncate">{experiment.command}</code>
        </div>
      </div>
    </div>
  </div>
</div>
