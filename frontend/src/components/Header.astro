---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Overview' },
  { href: '/tutorials', label: 'Tutorials (14)' },
  { href: '/notes', label: 'Notes (13)' },
  { href: '/results', label: 'Results Explorer' },
  { href: '/explainers', label: 'Interactive Explainers' },
];
---

<header class="sticky top-0 z-40 w-full bg-white/80 dark:bg-[#161618]/80 nav-blur border-b border-black/[0.06] dark:border-white/[0.08] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand / Title -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-7 h-7 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-black flex items-center justify-center font-bold text-xs tracking-wider transition-transform group-hover:scale-105">
        L
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          Linear LLM Representations Lab
        </span>
        <span class="text-[10px] text-neutral-500 dark:text-neutral-400 uppercase tracking-widest hidden sm:inline">
          Interactive Research Textbook
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
      {
        navLinks.map((link) => {
          const isActive =
            link.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`px-3 py-1.5 rounded-full transition-colors ${
                isActive
                  ? 'bg-neutral-100 dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100 font-semibold'
                  : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100/60 dark:hover:bg-neutral-800/60'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Right utility bar: Search + Progress indicator + Theme Toggle -->
    <div class="flex items-center gap-2">
      <!-- Search Button -->
      <button
        type="button"
        data-open-search
        class="inline-flex items-center gap-2 px-3 py-1.5 text-xs text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800/80 hover:bg-neutral-200/60 dark:hover:bg-neutral-700/60 rounded-full border border-black/[0.04] dark:border-white/[0.06] transition-colors focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none"
        aria-label="Search"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden sm:inline px-1 py-0.2 bg-white dark:bg-neutral-900 border border-black/10 dark:border-white/10 rounded text-[10px] font-mono">
          ⌘K
        </kbd>
      </button>

      <!-- Reading Progress Pill -->
      <div
        id="header-progress-pill"
        class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-medium text-neutral-600 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800 rounded-full"
        title="Completed units"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span id="header-progress-count">0 / 27 read</span>
      </div>

      <ThemeToggle />

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded-lg focus-visible:ring-2 focus-visible:ring-blue-500"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile dropdown menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-black/[0.06] dark:border-white/[0.08] px-4 py-3 bg-white dark:bg-[#161618] space-y-1">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded-lg text-sm font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</header>

<script is:inline>
  function updateHeaderProgress() {
    try {
      const stored = localStorage.getItem('llr_completed_units');
      const completed = stored ? JSON.parse(stored) : [];
      const countEl = document.getElementById('header-progress-count');
      if (countEl) {
        countEl.textContent = `${completed.length} / 27 read`;
      }
    } catch {}
  }

  updateHeaderProgress();
  window.addEventListener('llr:progress-updated', updateHeaderProgress);

  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const isExpanded = menu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
  });
</script>
